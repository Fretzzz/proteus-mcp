{
  "name": "proteus-mcp",
  "version": "0.1.0",
  "description": "MCP server for Labcenter Proteus 8: read, query and edit .pdsprj projects (components, netlists, BOM, firmware) and drive the Proteus app, built on a reverse-engineered model of the project file format.",
  "type": "module",
  "bin": {
    "proteus-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/format.test.mjs",
    "corpus": "npm run build && node test/corpus.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proteus",
    "labcenter",
    "isis",
    "pdsprj",
    "schematic",
    "netlist",
    "eda"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
